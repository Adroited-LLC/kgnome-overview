<ui version="4.0">
 <class>KGnomeOverviewConfigForm</class>
 <widget class="QWidget" name="KGnomeOverviewConfigForm">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_BlurBackground">
     <property name="text">
      <string>Blur the wallpaper behind the overview</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="labelIconScale">
     <property name="text">
      <string>Icon size multiplier:</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QDoubleSpinBox" name="kcfg_IconScale">
     <property name="minimum">
      <double>0.5</double>
     </property>
     <property name="maximum">
      <double>3.0</double>
     </property>
     <property name="singleStep">
      <double>0.25</double>
     </property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_TopRightCorner">
     <property name="text">
      <string>Toggle the overview from the top-right screen corner</string>
     </property>
    </widget>
   </item>
   <item row="3" column="0" colspan="2">
    <widget class="QLabel" name="labelFavorites">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>The dash shows your application launcher favourites. To override them: kwriteconfig6 --file kwinrc --group Effect-kgnomeoverview --key FavoriteApps "firefox.desktop,org.kde.dolphin.desktop"</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
