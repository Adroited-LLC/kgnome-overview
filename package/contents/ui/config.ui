<ui version="4.0">
 <class>KGnomeOverviewConfigForm</class>
 <widget class="QWidget" name="KGnomeOverviewConfigForm">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_BlurBackground">
     <property name="text">
      <string>Blur the wallpaper behind the overview</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="labelIconScale">
     <property name="text">
      <string>Icon size multiplier:</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QDoubleSpinBox" name="kcfg_IconScale">
     <property name="minimum">
      <double>0.5</double>
     </property>
     <property name="maximum">
      <double>3.0</double>
     </property>
     <property name="singleStep">
      <double>0.25</double>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="labelHotCorner">
     <property name="text">
      <string>Hot corner:</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="QComboBox" name="kcfg_HotCorner">
     <item><property name="text"><string>None</string></property></item>
     <item><property name="text"><string>Top left (GNOME)</string></property></item>
     <item><property name="text"><string>Top right</string></property></item>
     <item><property name="text"><string>Bottom left</string></property></item>
     <item><property name="text"><string>Bottom right</string></property></item>
    </widget>
   </item>
   <item row="4" column="0">
    <widget class="QLabel" name="gestureLabel">
     <property name="text">
      <string>Touchpad swipe fingers (0 = off):</string>
     </property>
    </widget>
   </item>
   <item row="4" column="1">
    <widget class="QSpinBox" name="kcfg_GestureFingers">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>5</number>
     </property>
    </widget>
   </item>
   <item row="5" column="0">
    <widget class="QLabel" name="labelIconSize">
     <property name="text">
      <string>App grid icon size (px, 0 = GNOME automatic):</string>
     </property>
    </widget>
   </item>
   <item row="5" column="1">
    <widget class="QSpinBox" name="kcfg_IconSize">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>256</number>
     </property>
    </widget>
   </item>
   <item row="6" column="0">
    <widget class="QLabel" name="labelColumns">
     <property name="text">
      <string>App grid columns (0 = GNOME automatic):</string>
     </property>
    </widget>
   </item>
   <item row="6" column="1">
    <widget class="QSpinBox" name="kcfg_Columns">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>20</number>
     </property>
    </widget>
   </item>
   <item row="7" column="0">
    <widget class="QLabel" name="labelRows">
     <property name="text">
      <string>App grid rows (0 = automatic):</string>
     </property>
    </widget>
   </item>
   <item row="7" column="1">
    <widget class="QSpinBox" name="kcfg_Rows">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>12</number>
     </property>
    </widget>
   </item>
   <item row="3" column="0" colspan="2">
    <widget class="QLabel" name="labelFavorites">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>The dash shares its favourites with the Kickoff launcher (two-way). install.sh picks the launcher; to use a separate list instead clear FavoritesClient: kwriteconfig6 --file kwinrc --group Effect-kgnomeoverview --key FavoritesClient ""</string>
     </property>
    </widget>
   </item>
   <item row="8" column="0">
    <widget class="QLabel" name="labelDashIconSize">
     <property name="text">
      <string>Dash icon size (px, GNOME 64):</string>
     </property>
    </widget>
   </item>
   <item row="8" column="1">
    <widget class="QSpinBox" name="kcfg_DashIconSize">
     <property name="minimum">
      <number>16</number>
     </property>
     <property name="maximum">
      <number>256</number>
     </property>
    </widget>
   </item>
   <item row="9" column="0">
    <widget class="QLabel" name="labelSearchFocusReturnMs">
     <property name="text">
      <string>Search: cursor back to the entry after (ms, 0 = off):</string>
     </property>
    </widget>
   </item>
   <item row="9" column="1">
    <widget class="QSpinBox" name="kcfg_SearchFocusReturnMs">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>5000</number>
     </property>
    </widget>
   </item>
   <item row="10" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_HideFavoritesInGrid">
     <property name="text">
      <string>Hide dash favourites from the app grid (GNOME)</string>
     </property>
    </widget>
   </item>
   <item row="11" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_DynamicWorkspaces">
     <property name="text">
      <string>Dynamic workspaces: keep one empty desktop at the end, remove empty desktops (GNOME)</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
