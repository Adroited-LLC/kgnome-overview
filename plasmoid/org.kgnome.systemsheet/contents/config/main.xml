<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- "single": one power (or battery) icon; "icons": GNOME's status icons (network, volume, battery/power) -->
    <entry name="compactStyle" type="String"><default>single</default></entry>
    <!-- "auto": GNOME's light or dark palette following the Plasma theme; "dark"; "light" -->
    <entry name="styleVariant" type="String"><default>auto</default></entry>
    <!-- "gnome": GNOME's default accent #3584e4; "plasma": the KDE accent colour -->
    <entry name="accentSource" type="String"><default>gnome</default></entry>
    <!-- corner radius of the sheet card in px; 0 = square, flush with the Plasma popup frame like other
         KDE widgets (GNOME 50 uses 36). Toggles, buttons and sliders keep their GNOME shapes. -->
    <entry name="sheetRadius" type="Int"><default>0</default></entry>
    <!-- GNOME 50 has no user header in the menu; optional -->
    <entry name="showUserHeader" type="Bool"><default>false</default></entry>
    <entry name="showToggles" type="Bool"><default>true</default></entry>
    <!-- Dark Style applies the default light/dark Global Theme (plasma-apply-lookandfeel) -->
    <entry name="showDarkStyle" type="Bool"><default>true</default></entry>
    <!-- Developer hook: changing it (e.g. from a Plasma script) opens the menu -->
    <entry name="expandRequest" type="Int"><default>0</default></entry>
  </group>
</kcfg>
